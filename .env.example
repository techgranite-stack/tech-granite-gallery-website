# Copy to .env.local (local) and add in the Vercel dashboard (production).

# Resend — enquiry emails
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=

# Google Reviews section (src/lib/google-reviews.ts)
# 1. Google Cloud Console → enable "Places API (New)"
# 2. Create an API key; restrict it to Places API (New)
# 3. (Optional) GOOGLE_PLACE_ID — if blank it is auto-resolved once and cached.
#    Find it at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
